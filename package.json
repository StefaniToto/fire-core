{
  "name": "code-from-root",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx run-many --target=serve",
    "start:all": "pnpm --stream -r start ",
    "start:dev": "pnpm --stream -r run start:dev",
    "dev": "admin dev",
    "test": "ng test",
    "write:env": "ngx-scripts env npm_package_version",
    "clean": "rm -rf .parcel-cache && pnpm -r run clean",
    "lint": "npm run lint:js -- --fix && npm run lint:css -- --fix && npm run lint:format",
    "format": "npx prettier \"src/**/*.{js,jsx,ts,tsx,html,css,scss}\" --write",
    "prepare": "husky install",
    "prettier": "prettier --config .prettierrc --check \"apps/**/*.{ts,css,html}\"",
    "prettier:check": "prettier --list-different \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "precommit": "lint-staged",
    "generate": "ng generate"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/eslint-plugin": "^19.0.2",
    "@angular-eslint/template-parser": "^19.0.2",
    "@angular/animations": "19.0.5",
    "@angular/cdk": "19.0.4",
    "@angular/common": "19.0.5",
    "@angular/compiler": "19.0.5",
    "@angular/core": "19.0.5",
    "@angular/forms": "19.0.5",
    "@angular/platform-browser": "19.0.5",
    "@angular/platform-browser-dynamic": "19.0.5",
    "@angular/router": "19.0.5",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "10.4.15",
    "@nrwl/linter": "19.8.4",
    "@prisma/client": "^6.1.0",
    "@schematics/angular": "^19.0.6",
    "bcrypt": "^5.1.1",
    "class-validator": "^0.14.1",
    "express": "^4.21.2",
    "passport-jwt": "^4.0.1",
    "primeicons": "^7.0.0",
    "primeng": "19.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended-scss": "^14.1.0",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.0.6",
    "@angular-devkit/core": "19.0.6",
    "@angular-eslint/eslint-plugin-template": "19.0.2",
    "@angular/compiler-cli": "19.0.5",
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "10.4.15",
    "@nrwl/eslint-plugin-nx": "19.8.4",
    "@nrwl/jest": "19.8.4",
    "@nrwl/webpack": "19.8.4",
    "@nx/angular": "20.3.0",
    "@nx/nest": "^20.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "~9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-preset-angular": "14.4.2",
    "lint-staged": "^15.2.11",
    "nx": "20.3.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "tslib": "^2.8.1",
    "typescript": "5.7.2"
  },
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.scss",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "lint-staged": {
    "*.{js,ts,json,css,scss,html}": [
      "npm run lint"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "ng build --prod"
    }
  },
  "nx": {}
}
